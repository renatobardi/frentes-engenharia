# Copie para .env (que fica fora do git) e preencha. Aqui vão só os nomes.
# Os segredos e a URL do banco vêm só do ambiente e não têm valor padrão em produção.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
EVENTOS_WEBHOOK_TOKEN=
# URL do Postgres do oute-supabase-db, com a senha da role do app (do cofre). Em desenvolvimento,
# sem ela, vale o `db` do `make db`.
EVENTOS_DATABASE_URL=

# Opcionais, sem segredo (lidos pelo docker compose):
# EVENTOS_PUBLICAR=127.0.0.1:8000
# EVENTOS_COMMIT=
# REVISAO_AUTOMATICA=0
